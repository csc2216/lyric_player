# 翻譯後端：claude_cli（預設，呼叫 `claude -p`，使用 Claude 訂閱額度，需先登入 Claude Code）
#           api（Anthropic API，需要 ANTHROPIC_API_KEY）
TRANSLATOR_BACKEND=claude_cli
# claude 指令的完整路徑（伺服器找不到 claude 時才需要設；在終端機執行 which claude 查詢）
CLAUDE_CLI_PATH=claude
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-opus-5-5
LIBRARY_DIR=./library
PORT=8765
# "sync"（選時長最接近的影片）或 "mv"（偏好 MV）
VIDEO_PREFERENCE=sync

# ---- 給其他裝置（iPad、室友）用：透過 tailscale serve ----
# 主人的 Tailscale 帳號（登入用的 email）；用這個帳號的裝置有完整權限
OWNER_LOGIN=
# 訪客 PIN：請求沒有 Tailscale 身分時（例如分享進來的裝置）要先輸入；留空 = 不開放這類訪客
GUEST_PIN=
# 每位訪客每天最多建立幾首新歌（用主人的翻譯額度）
GUEST_DAILY_BUILDS=10
